
class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            LearningTheme {
                Parent(
                    Modifier.fillMaxSize()
                )
            }
        }
    }
}
}


@Composable
fun Parent(modifier: Modifier = Modifier) {
    var message by remember { mutableStateOf("Hello!") }

    Column(
        verticalArrangement = Arrangement.Center,
        horizontalAlignment = Alignment.CenterHorizontally,
        modifier = modifier
            .padding(WindowInsets.safeDrawing.asPaddingValues())
    ) {
        AppTitle()
        ChangeTextButton { message = "Button Clicked!" }
        MessageText(message)
    }
}

@Composable
fun AppTitle(
    modifier: Modifier = Modifier
) {
    Text(
        text = "This the a learning check.",
        fontSize = 30.sp,
        fontWeight = FontWeight.Bold,
        modifier = modifier
    )
}

@Composable
fun ChangeTextButton(onClick: () -> Unit) {
    Button(
        onClick = onClick
    ) {
        Text("Click me!")
    }
}

@Composable
fun MessageText(text: String) {
    Text(text)
}

@Preview(showBackground = true)
@Composable
private fun AppTitlePreview() {
    Parent(Modifier.fillMaxSize())
}